# EdgeAfterCosts — example configuration.
#
# Copy to .env and adjust. Every value below is a safe local-development
# placeholder; nothing here is a real credential. For any deployment that is
# reachable by someone other than you, replace every CHANGE_ME with a value
# generated by `openssl rand -hex 32` and keep the file out of version control.

ENV=development
DEBUG=false

# ---- MODE ------------------------------------------------------------------
# PAPER is the only supported value. The application refuses to start on
# anything else, and there is no live-order code path that could be enabled.
TRADING_MODE=PAPER

# ---- HTTP ------------------------------------------------------------------
# The dashboard and the API are served under a common path prefix so that a
# single origin can host them side by side. Set BASE_PATH to "" to serve at the
# domain root; if you change it, change `basePath`/`assetPrefix` in
# web/next.config.mjs to match.
BASE_PATH=/edge-after-costs
PUBLIC_BASE_URL=http://localhost:3000/edge-after-costs
SECRET_KEY=CHANGE_ME
# Set to false for plain-HTTP local development, true behind TLS.
COOKIE_SECURE=false

# First administrator, created only while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ---- storage ---------------------------------------------------------------
POSTGRES_DB=edge_after_costs
POSTGRES_USER=edge_after_costs
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://edge_after_costs:CHANGE_ME@edge-after-costs-db:5432/edge_after_costs
REDIS_URL=redis://edge-after-costs-redis:6379/0

# ---- exchange (public market data only) ------------------------------------
# Public, unauthenticated endpoints. No API key exists or is accepted: the
# application contains no request-signing code and no authenticated endpoint.
EXCHANGE_REST_BASE=https://api.binance.us
EXCHANGE_WS_BASE=wss://stream.binance.us:9443

# ---- fees ------------------------------------------------------------------
# standard = pessimistic 0.10%/0.10%. tier0 = a published promotional table.
FEE_MODEL=standard
FEE_STANDARD_MAKER_BPS=10
FEE_STANDARD_TAKER_BPS=10

# ---- capital & risk --------------------------------------------------------
STARTING_EQUITY=500
RISK_PER_TRADE_PCT=0.5
MAX_CONCURRENT_POSITIONS=3
MAX_POSITION_PCT_EQUITY=35
MAX_TOTAL_EXPOSURE_PCT=90
MAX_CONCURRENT_RISK_PCT=1.5
DAILY_LOSS_LIMIT_PCT=3
WEEKLY_LOSS_LIMIT_PCT=7
LOSS_STREAK_LEN=4
LOSS_STREAK_COOLDOWN_MINUTES=45
MIN_NET_EDGE_BPS=4
MIN_NET_EDGE_USD=0.05
MIN_NOTIONAL_USD=10

# ---- universe --------------------------------------------------------------
UNIVERSE_MAX_SYMBOLS=12
UNIVERSE_HOT_SYMBOLS=5
UNIVERSE_MIN_QUOTE_VOLUME_24H=2000000
UNIVERSE_REFRESH_SECONDS=900

# ---- execution simulation --------------------------------------------------
SIM_LATENCY_MS=250
SIM_ADVERSE_BPS=0.5
SIM_LIMIT_MISS_RATIO=0.35
SIMULATOR_VERSION=sim-1.0.0

# ---- worker cadence --------------------------------------------------------
# These defaults are sized for a small 2-core machine. Lower them only after
# measuring CPU headroom on your own hardware.
EVAL_INTERVAL_MS=1000
POSITION_MONITOR_INTERVAL_MS=500
SNAPSHOT_INTERVAL_SECONDS=60
TICK_RETENTION_HOURS=48
EVENT_RETENTION_DAYS=30
