# Crypto Micro-Profit Trader — server configuration.
# Copy to .env, fill the secrets, chmod 600. Never commit the real file.

ENV=production
DEBUG=false

# ---- MODE ------------------------------------------------------------------
# PAPER is the only supported value in V1. The application refuses to start on
# anything else, and there is no live-order code path to enable.
TRADING_MODE=PAPER

BASE_PATH=/cryptobot
PUBLIC_BASE_URL=https://your-domain.example/cryptobot
SECRET_KEY=CHANGE_ME
COOKIE_SECURE=true
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ---- storage ---------------------------------------------------------------
POSTGRES_DB=cryptobot
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://cryptobot:CHANGE_ME@cryptobot-db:5432/cryptobot
REDIS_URL=redis://cryptobot-redis:6379/0

# ---- exchange (public market data only) ------------------------------------
EXCHANGE_REST_BASE=https://api.binance.us
EXCHANGE_WS_BASE=wss://stream.binance.us:9443

# ---- fees ------------------------------------------------------------------
# standard = pessimistic 0.10%/0.10%. tier0 = published promo table.
FEE_MODEL=standard
FEE_STANDARD_MAKER_BPS=10
FEE_STANDARD_TAKER_BPS=10

# ---- capital & risk --------------------------------------------------------
STARTING_EQUITY=500
RISK_PER_TRADE_PCT=0.5
MAX_CONCURRENT_POSITIONS=3
MAX_POSITION_PCT_EQUITY=35
MAX_TOTAL_EXPOSURE_PCT=90
MAX_CONCURRENT_RISK_PCT=1.5
DAILY_LOSS_LIMIT_PCT=3
WEEKLY_LOSS_LIMIT_PCT=7
LOSS_STREAK_LEN=4
LOSS_STREAK_COOLDOWN_MINUTES=45
MIN_NET_EDGE_BPS=4
MIN_NET_EDGE_USD=0.05
MIN_NOTIONAL_USD=10

# ---- universe --------------------------------------------------------------
UNIVERSE_MAX_SYMBOLS=12
UNIVERSE_HOT_SYMBOLS=5
UNIVERSE_MIN_QUOTE_VOLUME_24H=2000000
UNIVERSE_REFRESH_SECONDS=900

# ---- execution simulation --------------------------------------------------
SIM_LATENCY_MS=250
SIM_ADVERSE_BPS=0.5
SIM_LIMIT_MISS_RATIO=0.35
SIMULATOR_VERSION=sim-1.0.0

# ---- worker cadence (2 vCPU host — do not lower without measuring) ---------
EVAL_INTERVAL_MS=1000
POSITION_MONITOR_INTERVAL_MS=500
SNAPSHOT_INTERVAL_SECONDS=60
TICK_RETENTION_HOURS=48
EVENT_RETENTION_DAYS=30
